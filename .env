# EBC Asset Agent v4.1.9 — Configuration
# ─────────────────────────────────────────────────────────────
# This file is bundled inside the installer and deployed to:
#   C:\Program Files\EBC Asset Agent\resources\.env
#
# Edit these values before building the installer.

# Primary API server (Node.js on port 3000)
SERVER_URL=http://103.140.194.214:3000

# PHP fallback URL (used if Node.js API is unreachable)
# FIX: Set PHP_SSL_IGNORE=true below when this site uses a self-signed or
#      chain-incomplete SSL certificate (causes "unable to verify the first
#      certificate" in agent logs).
PHP_URL=https://darleybutler.lk/assetAgent

# Set to "true" to bypass SSL certificate verification for PHP_URL only.
# Use this when darleybutler.lk has an untrusted/self-signed cert.
# Never set this for SERVER_URL (plain http does not need it).
PHP_SSL_IGNORE=true

# Shared API key — must match server config
API_KEY=EBC@Asset2024!SecureKey99

# Hour of day for scheduled daily sync (24h, Colombo time)
SYNC_HOUR=8

# Admin password for agent quit/uninstall protection (v4.1.9+)
# Change this to your own secure password before deploying.
# The password is hashed (SHA-256) — never stored in plaintext.
ADMIN_PASSWORD=EBC@Admin2024
