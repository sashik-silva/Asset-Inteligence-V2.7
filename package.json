{
  "name": "ebc-asset-agent",
  "version": "4.2.7",
  "description": "EBC IT Asset Agent",
  "main": "main.js",
  "author": "EBC IT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:x64": "electron-builder --win --x64",
    "build:ia32": "electron-builder --win --ia32",
    "build": "npm run build:x64 && npm run build:ia32",
    "build:watchdog": "pkg watchdog.js --targets node18-win-x64 --output dist-watchdog/EBC-Asset-Watchdog-x64.exe && node build-scripts/hide-console.js dist-watchdog/EBC-Asset-Watchdog-x64.exe",
    "build:all": "npm run build:watchdog && npm run build"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "node-schedule": "^2.1.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "@yao-pkg/pkg": "^5.11.5"
  },
  "build": {
    "appId": "lk.darleybutler.ebcassetagent",
    "productName": "EBC Asset Agent",
    "copyright": "Copyright \u00a9 2024 EBC IT",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "EBC Asset Agent",
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": true,
      "signingHashAlgorithms": ["sha256"],
      "legalTrademarks": "EBC IT"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "EBC-Asset-Agent-Setup-${version}-${arch}.exe",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "EBC Asset Agent",
      "runAfterFinish": false,
      "perMachine": true,
      "allowElevation": true,
      "include": "installer.nsh",
      "installerLanguages": [
        "en_US"
      ]
    },
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "status.html",
        "to": "status.html"
      }
    ],
    "afterPack": "build-scripts/after-pack.js"
  }
}